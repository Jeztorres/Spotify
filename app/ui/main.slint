export struct LibraryEntry { uri: string, title: string, subtitle: string, cover: image, pinned: bool, active: bool, special: bool, kind: string }
export struct QueueRow { title: string, artist: string, tag: string, duration: string, cover: image }
export struct CardEntry { title: string, subtitle: string, cover: image }
export struct TrackEntry { index: int, uri: string, cover: image, title: string, artist: string, album: string, duration: string, playcount: string, explicit: bool, playing: bool, saved: bool, like-busy: bool }
export struct LyricEntry { text: string, translation: string, right: bool, bg: string }
export struct GenreEntry { name: string, query: string, from: color, to: color }
export struct ConnectDevice { id: string, name: string, kind: string, icon: string, active: bool, local: bool }
export struct ArtistChoice { name: string, avatar: image }

