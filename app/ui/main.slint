component LibraryRow inherits Rectangle {
    in property <LibraryEntry> entry;
    in property <bool> drop-highlight: false;
    in property <color> accent: Theme.green-bright;
    callback clicked();
    callback context(length, length);
    height: 56px;
    border-radius: 8px;
    background: root.drop-highlight ? Theme.green.with-alpha(0.28) : (root.entry.active ? Theme.hover : (ta.has-hover ? Theme.hover.with-alpha(0.6) : transparent));
    border-width: root.drop-highlight ? 2px : 0px;
    border-color: Theme.green-bright;
    HorizontalLayout {
        padding: 8px;
        spacing: 12px;
        if root.entry.special: Rectangle {
            width: 40px;
            height: 40px;
            border-radius: 6px;
            background: @linear-gradient(135deg, rgb(70, 50, 200) 0%, Theme.green 100%);
            Text { text: "♥"; color: Theme.fg; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
        }
        if !root.entry.special: Cover { width: 40px; height: 40px; source: root.entry.cover; corner: root.entry.kind == "artist" ? 20px : 6px; }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.entry.title;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
                color: root.entry.active ? root.accent : Theme.fg;
            }
            Text {
                text: (root.entry.pinned ? "📌 " : "") + root.entry.subtitle;
                font-size: 12px;
                overflow: elide;
                color: Theme.sub;
            }
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(e) => { if e.button == PointerEventButton.right && e.kind == PointerEventKind.up { root.context(root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y); } }
    }
}

// Fila de menú con icono para el menú emergente de la barra del reproductor.
component BarMenuRow inherits Rectangle {
    in property <string> icon-d;
    in property <string> label;
    in property <bool> active;
    in property <color> fg: Theme.fg;
    in property <color> icon-color: Theme.fg.with-alpha(0.851);
    in property <color> active-color: Theme.fg;
    in property <color> hover-bg: Theme.fg.with-alpha(0.110);
    callback clicked();
    height: 38px; border-radius: 10px;
    background: ta.has-hover ? root.hover-bg : transparent;
    HorizontalLayout {
        padding-left: 8px; padding-right: 8px; spacing: 12px;
        IconPath { y: (parent.height - self.height) / 2; d: root.icon-d; tint: root.active ? root.active-color : root.icon-color; }
        Text { text: root.label; color: root.active ? root.active-color : root.fg; font-size: 13px; font-weight: 600; vertical-alignment: center; horizontal-alignment: left; overflow: elide; }
    }
    accessible-role: button; accessible-label: root.label;
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component LikeButton inherits Rectangle {
    in property <bool> saved;
    in property <bool> busy;
    in property <bool> enabled: true;
    in property <color> active-color: Theme.green-bright;
    in property <color> icon-color: Theme.fg.with-alpha(0.733);
    in property <color> hover-bg: Theme.fg.with-alpha(0.094);
    callback clicked();
    width: 32px; height: 32px; border-radius: 16px;
    background: like-touch.has-hover ? root.hover-bg : transparent;
    opacity: root.enabled && !root.busy ? 1 : 0.4;
    Text { text: root.saved ? "♥" : "♡"; color: root.saved ? root.active-color : root.icon-color; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
    accessible-role: button; accessible-label: root.saved ? "Quitar de Tus me gusta" : "Guardar en Tus me gusta";
    like-touch := TouchArea { enabled: root.enabled && !root.busy; clicked => { root.clicked(); } }
}

component MenuChoice inherits Rectangle {
    in property <string> label;
    in property <string> icon: "";
    in property <color> icon-tint: Theme.fg.with-alpha(0.784);
    in property <bool> enabled: true;
    callback clicked();
    height: 36px; border-radius: 6px;
    background: menu-touch.has-hover && root.enabled ? Theme.fg.with-alpha(0.086) : transparent;
    HorizontalLayout {
        padding-left: 10px; padding-right: 10px; spacing: 10px;
        if root.icon != "": IconPath {
            y: (parent.height - self.height) / 2;
            width: 15px; height: 15px;
            d: root.icon;
            tint: root.enabled ? (menu-touch.has-hover ? Theme.fg : root.icon-tint) : Theme.sub;
        }
        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: root.enabled ? Theme.fg : Theme.sub;
            horizontal-alignment: left; vertical-alignment: center;
            font-size: 13px; font-weight: 500; overflow: elide;
        }
    }
    menu-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

component AvatarChoice inherits Rectangle {
    in property <string> label;
    in property <image> avatar;
    in property <bool> square: false;
    in property <bool> enabled: true;
    callback clicked();
    height: 40px; border-radius: 6px;
    background: choice-touch.has-hover && root.enabled ? Theme.fg.with-alpha(0.094) : transparent;
    HorizontalLayout {
        padding-left: 8px; padding-right: 10px; spacing: 10px;
        Rectangle {
            y: (parent.height - self.height) / 2;
            width: 28px; height: 28px;
            border-radius: root.square ? 4px : 14px;
            background: Theme.fg.with-alpha(0.094);
            clip: true;
            if root.avatar.width > 0: Image {
                width: 100%; height: 100%;
                source: root.avatar;
                image-fit: cover;
            }
            if root.avatar.width == 0: IconPath {
                x: 6px; y: 6px; width: 16px; height: 16px;
                d: root.square ? Icons.note : Icons.artist;
                tint: Theme.fg.with-alpha(0.667);
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: root.enabled ? Theme.fg : Theme.sub;
            horizontal-alignment: left;
            vertical-alignment: center;
            font-size: 13px;
            font-weight: 500;
            overflow: elide;
        }
    }
    choice-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

component MediaCard inherits Rectangle {
    in property <CardEntry> entry;
    in property <bool> round;
    callback clicked();
    border-radius: 8px;
    background: ta.has-hover ? Theme.fg.with-alpha(0.086) : transparent;
    animate background { duration: 150ms; }
    VerticalLayout {
        padding: 10px;
        spacing: 10px;
        Cover { height: self.width; corner: root.round ? self.width / 2 : 6px; fallback: root.round ? transparent : Theme.hover; source: root.entry.cover; }
        VerticalLayout {
            spacing: 2px;
            Text { text: root.entry.title; font-size: 14px; font-weight: 700; overflow: elide; color: Theme.fg; horizontal-alignment: root.round ? center : left; }
            Text { text: root.entry.subtitle; font-size: 12px; overflow: elide; color: Theme.sub; horizontal-alignment: root.round ? center : left; }
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// La cabecera y todas las filas comparten exactamente las mismas columnas.
// Filas normales según el ancho disponible:
//   > 720 px  → Portada + Título · Artista · Álbum · Duración
//   540–720   → sin columna de Álbum
//   < 540 px  → el artista se apila bajo el título y la portada baja a 42 px
global TrackColumns {
    public pure function mode(w: length) -> int { return w > 720px ? 2 : (w >= 540px ? 1 : 0); }
    // Espacio entre la portada (x = 100) y la duración.
    public pure function span(w: length) -> length { return max(0px, w - 280px); }
    public pure function title-w(w: length) -> length {
        return mode(w) == 2 ? span(w) * 0.40 - 12px : (mode(w) == 1 ? span(w) * 0.58 - 12px : duration-x(w) - 116px);
    }
    public pure function artist-x(w: length) -> length { return 100px + (mode(w) == 2 ? span(w) * 0.40 : span(w) * 0.58); }
    public pure function artist-w(w: length) -> length {
        return mode(w) == 2 ? span(w) * 0.27 - 12px : (mode(w) == 1 ? duration-x(w) - artist-x(w) - 16px : duration-x(w) - 116px);
    }
    public pure function album-x(w: length) -> length { return 100px + span(w) * 0.67; }
    public pure function duration-x(w: length) -> length { return w - 164px; }
    public pure function pop-plays-w(w: length) -> length { return w < 660px ? 94px : 114px; }
    public pure function pop-plays-x(w: length) -> length { return duration-x(w) - pop-plays-w(w) - 10px; }
    public pure function pop-mid-w(w: length) -> length { return max(120px, pop-plays-x(w) - 108px); }
    public pure function pop-artist-x(w: length) -> length { return 98px + pop-mid-w(w) * 0.56 + 6px; }
}

component TrackTableHeader inherits Rectangle {
    in property <bool> popular: false;
    property <int> mode: TrackColumns.mode(self.width);
    height: root.popular ? 28px : 32px;
    Text { x: 12px; width: 24px; height: parent.height; text: "#"; horizontal-alignment: center; vertical-alignment: center; font-size: 12px; color: Theme.fg.with-alpha(0.733); }
    Text {
        x: 48px;
        width: root.popular ? TrackColumns.pop-artist-x(root.width) - 56px : TrackColumns.title-w(root.width) + 52px;
        height: parent.height;
        text: root.popular ? "Canción" : "Título";
        horizontal-alignment: left; vertical-alignment: center; font-size: 12px; color: Theme.fg.with-alpha(0.733); overflow: elide;
    }
    if !root.popular && root.mode >= 1: Text { x: TrackColumns.artist-x(root.width); width: TrackColumns.artist-w(root.width); height: parent.height; text: "Artista"; horizontal-alignment: left; vertical-alignment: center; font-size: 12px; color: Theme.fg.with-alpha(0.733); overflow: elide; }
    if !root.popular && root.mode == 2: Text { x: TrackColumns.album-x(root.width); width: TrackColumns.duration-x(root.width) - self.x - 16px; height: parent.height; text: "Álbum"; horizontal-alignment: left; vertical-alignment: center; font-size: 12px; color: Theme.fg.with-alpha(0.733); overflow: elide; }
    if root.popular: Text { x: TrackColumns.pop-artist-x(root.width); width: TrackColumns.pop-plays-x(root.width) - self.x - 10px; height: parent.height; text: "Artistas"; horizontal-alignment: left; vertical-alignment: center; font-size: 12px; color: Theme.fg.with-alpha(0.733); }
    if root.popular: Text { x: TrackColumns.pop-plays-x(root.width); width: TrackColumns.pop-plays-w(root.width); height: parent.height; text: "Reproducciones"; horizontal-alignment: right; vertical-alignment: center; font-size: 11px; color: Theme.fg.with-alpha(0.733); }
    Text { x: TrackColumns.duration-x(root.width); width: 48px; height: parent.height; text: "Duración"; horizontal-alignment: right; vertical-alignment: center; font-size: 11px; color: Theme.fg.with-alpha(0.733); }
}

component TrackRow inherits Rectangle {
    in property <TrackEntry> t;
    // Fondo sólido de los botones (+ y ⋯): el color de la página, no negro.
    in property <color> button-bg: #26262a;
    in property <bool> popular: false;
    callback clicked();
    callback open-artist(length, length);
    callback open-album();
    callback add-playlist(length, length);
    callback context(length, length);
    callback like();
    // Arrastre (posición absoluta del puntero): mover a una playlist o reordenar.
    in property <bool> draggable: false;
    callback drag-move(length, length);
    callback drag-end(length, length);
    property <bool> dragging: false;
    property <bool> suppress-click: false;
    // Filas normales: 2 = cuatro columnas, 1 = sin álbum, 0 = artista apilado bajo el título.
    property <int> mode: root.popular ? 2 : TrackColumns.mode(self.width);
    property <bool> stacked: !root.popular && root.mode == 0;
    property <bool> hovering: ta.has-hover || artist-ta.has-hover || album-ta.has-hover;
    height: 60px;
    border-radius: 4px;
    background: root.hovering ? Theme.fg.with-alpha(0.094) : transparent;
    ta := TouchArea {
        x: 0; y: 0; width: parent.width - 118px; height: parent.height;
        mouse-cursor: root.dragging ? grabbing : default;
        clicked => {
            if !root.suppress-click { root.clicked(); }
            root.suppress-click = false;
        }
        moved => {
            if root.draggable && self.pressed {
                if !root.dragging && (abs(self.mouse-x - self.pressed-x) > 8px || abs(self.mouse-y - self.pressed-y) > 8px) {
                    root.dragging = true;
                }
                if root.dragging {
                    root.drag-move(root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y);
                }
            }
        }
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.up { root.context(root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y); }
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down { root.suppress-click = false; }
            if e.button == PointerEventButton.left && (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) && root.dragging {
                root.dragging = false;
                root.suppress-click = true;
                root.drag-end(root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y);
            }
        }
    }
    if root.hovering: IconPath {
        x: 18px; y: (parent.height - self.height) / 2;
        width: 12px; height: 12px;
        d: root.t.playing ? "M6 4 H10 V20 H6 Z M14 4 H18 V20 H14 Z" : "M7 4.5 L19.5 12 L7 19.5 Z";
        solid: true;
        tint: Theme.fg;
    }
    if !root.hovering: Text {
        x: 12px; width: 24px; height: parent.height;
        text: "\{root.t.index}";
        horizontal-alignment: center; vertical-alignment: center;
        color: root.t.playing ? Theme.green-bright : Theme.fg.with-alpha(0.733); font-size: 13px;
        font-weight: root.t.playing ? 700 : 400;
    }
    Cover {
        x: 48px; y: (parent.height - self.height) / 2;
        width: root.stacked ? 42px : 40px; height: self.width;
        source: root.t.cover; corner: 3px;
    }
    HorizontalLayout {
        x: 100px;
        y: root.stacked ? 8px : 0px;
        width: root.popular ? TrackColumns.pop-artist-x(root.width) - 108px : TrackColumns.title-w(root.width);
        height: root.stacked ? 22px : parent.height;
        spacing: 6px;
        alignment: start;
        if root.t.explicit && !root.stacked: Rectangle {
            width: 15px; height: 15px; y: (parent.height - self.height) / 2;
            border-radius: 3px; background: Theme.fg.with-alpha(0.157);
            Text { text: "E"; color: Theme.fg.with-alpha(0.863); font-size: 9px; font-weight: 800; }
        }
        Text {
            horizontal-stretch: 1;
            text: root.t.title;
            horizontal-alignment: left; vertical-alignment: center;
            font-size: 14px; font-weight: 600; overflow: elide;
            color: root.t.playing ? Theme.green-bright : Theme.fg;
        }
    }
    Rectangle {
        x: root.popular ? TrackColumns.pop-artist-x(root.width) : (root.stacked ? 100px : TrackColumns.artist-x(root.width));
        y: root.stacked ? 32px : 0px;
        width: root.popular ? TrackColumns.pop-plays-x(root.width) - self.x - 10px : TrackColumns.artist-w(root.width);
        height: root.stacked ? 18px : parent.height;
        artist-label := Text {
            x: 0; y: 0; width: min(self.preferred-width, parent.width); height: parent.height;
            text: root.stacked && root.t.explicit ? "E  " + root.t.artist : root.t.artist;
            horizontal-alignment: left; vertical-alignment: center;
            font-size: root.stacked ? 12px : 13px; overflow: elide;
            color: artist-ta.has-hover ? Theme.fg : Theme.fg.with-alpha(0.733);
        }
        artist-ta := TouchArea {
            x: 0; y: 0; width: artist-label.width; height: parent.height;
            enabled: root.t.artist != "";
            mouse-cursor: root.t.artist != "" ? pointer : default;
            clicked => { root.open-artist(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.height + 2px); }
            pointer-event(e) => { if e.button == PointerEventButton.right && e.kind == PointerEventKind.up { root.context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } }
        }
    }
    Rectangle {
        visible: !root.popular && root.mode == 2;
        x: TrackColumns.album-x(root.width); width: TrackColumns.duration-x(root.width) - self.x - 16px;
        height: parent.height;
        album-label := Text {
            x: 0; y: 0; width: min(self.preferred-width, parent.width); height: parent.height;
            text: root.t.album; horizontal-alignment: left; vertical-alignment: center;
            overflow: elide; font-size: 13px;
            color: album-ta.has-hover ? Theme.fg : Theme.fg.with-alpha(0.733);
        }
        album-ta := TouchArea {
            x: 0; y: 0; width: album-label.width; height: parent.height;
            enabled: !root.popular && root.mode == 2 && root.t.album != "";
            mouse-cursor: !root.popular && root.mode == 2 && root.t.album != "" ? pointer : default;
            clicked => { root.open-album(); }
            pointer-event(e) => { if e.button == PointerEventButton.right && e.kind == PointerEventKind.up { root.context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } }
        }
    }
    if root.popular: Text {
        x: TrackColumns.pop-plays-x(root.width); width: TrackColumns.pop-plays-w(root.width);
        height: parent.height; text: root.t.playcount; horizontal-alignment: right; vertical-alignment: center;
        overflow: elide; font-size: 12px; color: Theme.fg.with-alpha(0.733);
    }
    Text { x: TrackColumns.duration-x(root.width); width: 48px; height: parent.height; text: root.t.duration; horizontal-alignment: right; vertical-alignment: center; font-size: 12px; color: Theme.fg.with-alpha(0.733); }
    LikeButton { x: parent.width - 110px; y: 14px; saved: root.t.saved; busy: root.t.like-busy; enabled: root.t.uri != ""; clicked => { root.like(); } }
    RoundIconButton { x: parent.width - 74px; y: 14px; bg-color: root.button-bg; icon-color: Theme.fg.with-alpha(0.878); d: Icons.plus; label: "Agregar a playlist"; enabled: root.t.uri != ""; clicked => { root.add-playlist(self.absolute-position.x, self.absolute-position.y + self.height); } }
    RoundIconButton { x: parent.width - 38px; y: 14px; bg-color: root.button-bg; icon-color: Theme.fg.with-alpha(0.878); d: Icons.more; label: "Más opciones de canción"; clicked => { root.context(self.absolute-position.x, self.absolute-position.y + self.height); } }
}

// Rejilla adaptable: tantas columnas como quepan (mín. 190 px).
component CardGrid inherits Rectangle {
    in property <[CardEntry]> cards;
    in property <bool> round;
    callback clicked(int);
    property <int> cols: max(1, floor(self.width / 190px));
    property <length> cell: (self.width - (self.cols - 1) * 16px) / self.cols;
    height: ceil(root.cards.length / self.cols) * (self.cell + 90px) + 8px;
    for card[i] in root.cards: MediaCard {
        x: mod(i, root.cols) * (root.cell + 16px);
        y: floor(i / root.cols) * (root.cell + 90px);
        width: root.cell;
        height: root.cell + 78px;
        entry: card; round: root.round;
        clicked => { root.clicked(i); }
    }
}

// Accesos recientes en dos filas, como en Spotify para escritorio.
component QuickGrid inherits Rectangle {
    in property <[CardEntry]> cards;
    callback clicked(int);
    property <int> cols: self.width >= 700px ? 4 : 2;
    property <length> cell: (self.width - (self.cols - 1) * 8px) / self.cols;
    height: ceil(min(root.cards.length, 8) / self.cols) * 64px;
    clip: true;
    for card[i] in root.cards: Rectangle {
        visible: i < 8;
        x: mod(i, root.cols) * (root.cell + 8px);
        y: floor(i / root.cols) * 64px;
        width: root.cell; height: 56px; border-radius: 4px;
        background: quick-touch.has-hover ? Theme.fg.with-alpha(0.188) : Theme.fg.with-alpha(0.086);
        Cover { x: 0; y: 0; width: 56px; height: 56px; source: card.cover; corner: 4px; }
        Text { x: 66px; width: parent.width - 76px; height: parent.height; text: card.title; horizontal-alignment: left; color: Theme.fg; font-size: 13px; font-weight: 700; vertical-alignment: center; overflow: elide; }
        quick-touch := TouchArea { clicked => { root.clicked(i); } }
    }
}

component CardShelf inherits Rectangle {
    in property <[CardEntry]> cards;
    in property <bool> round;
    callback clicked(int);
    height: root.cards.length > 0 ? 238px : 0px;
    shelf := ScrollView {
        horizontal-scrollbar-policy: always-off;
        vertical-scrollbar-policy: always-off;
        content-width: max(self.width, root.cards.length * 178px);
        content-height: 220px;
        for card[i] in root.cards: MediaCard {
            x: i * 178px; width: 174px; height: 218px;
            entry: card; round: root.round; clicked => { root.clicked(i); }
        }
    }
    if shelf.content-x < 0px: Rectangle {
        x: 2px; y: 72px; width: 30px; height: 42px; border-radius: 15px; background: #000000cc;
        Text { text: "‹"; font-size: 28px; color: Theme.fg; horizontal-alignment: center; vertical-alignment: center; }
        TouchArea { clicked => { shelf.content-x = min(0px, shelf.content-x + 356px); } }
    }
    if root.cards.length * 178px + shelf.content-x > root.width: Rectangle {
        x: parent.width - 32px; y: 72px; width: 30px; height: 42px; border-radius: 15px; background: #000000cc;
        Text { text: "›"; font-size: 28px; color: Theme.fg; horizontal-alignment: center; vertical-alignment: center; }
        TouchArea { clicked => { shelf.content-x = max(root.width - root.cards.length * 178px, shelf.content-x - 356px); } }
    }

}

component FilterChip inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();
    width: chip-text.preferred-width + 28px; height: 32px; border-radius: 16px;
    background: root.selected ? Theme.fg : (chip-touch.has-hover ? Theme.fg.with-alpha(0.188) : Theme.fg.with-alpha(0.094));
    chip-text := Text { text: root.label; color: root.selected ? Theme.on-fg : Theme.fg; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
    chip-touch := TouchArea { clicked => { root.clicked(); } }
}

// Fila de círculos de color. El índice 0 es la opción "automática" (`first-fill` + `first-label`).
component ColorSwatches inherits HorizontalLayout {
    in property <[color]> palette;
    in property <int> selected;
    in property <brush> first-fill;
    in property <string> first-label: "A";
    in property <string> first-name;
    callback picked(int);
    spacing: 5px;
    for c[i] in root.palette: Rectangle {
        width: 22px; height: 22px; border-radius: 11px; clip: true;
        background: i == 0 ? root.first-fill : c;
        border-width: root.selected == i ? 2px : 1px;
        border-color: root.selected == i ? Theme.fg : (sw-ta.has-hover ? Theme.fg.with-alpha(0.502) : Theme.fg.with-alpha(0.149));
        if i == 0: Text { text: root.first-label; color: Theme.fg; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
        if root.selected == i && i > 0: Rectangle {
            width: 7px; height: 7px; border-radius: 3.5px;
            background: c.red * 0.299 + c.green * 0.587 + c.blue * 0.114 > 150 ? #121214 : white;
        }
        accessible-role: button;
        accessible-label: i == 0 ? root.first-name : "Color " + i;
        sw-ta := TouchArea { mouse-cursor: pointer; clicked => { root.picked(i); } }
    }
}

component SettingGroup inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: 10px;
    VerticalLayout {
        spacing: 2px; padding-left: 6px;
        Text {
            text: root.title;
            color: Theme.fg;
            font-family: Theme.display-font;
            font-size: 17px;
            font-weight: 800;
            horizontal-alignment: left;
        }
        if root.subtitle != "": Text { text: root.subtitle; color: Theme.fg.with-alpha(0.549); font-size: 12px; horizontal-alignment: left; wrap: word-wrap; }
    }
    Rectangle {
        border-radius: 24px;
        background: Theme.green.mix(#ffffff, 0.04).with-alpha(0.09);
        border-width: 1px;
        border-color: Theme.fg.with-alpha(0.071);
        VerticalLayout { padding-top: 4px; padding-bottom: 4px; @children }
    }
}

// Fila de ajuste adaptable: el control va a la derecha si cabe y debajo del texto si no,
// para que nada se apriete en ventanas pequeñas.
component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <bool> last: false;
    property <length> pad: 20px;
    property <length> ctrl-w: ctrl.preferred-width;
    property <length> ctrl-h: ctrl.preferred-height;
    property <bool> stack: self.width - 2 * self.pad - self.ctrl-w - 18px < 230px;
    property <length> text-w: self.stack ? self.width - 2 * self.pad : self.width - 2 * self.pad - self.ctrl-w - 18px;
    height: self.stack
        ? 14px + txt.preferred-height + 12px + self.ctrl-h + 16px
        : max(66px, max(txt.preferred-height, self.ctrl-h) + 30px);
    txt := VerticalLayout {
        x: root.pad; width: root.text-w; height: self.preferred-height;
        y: root.stack ? 14px : (root.height - self.preferred-height) / 2;
        spacing: 3px;
        Text { text: root.title; color: Theme.fg; font-size: 14px; font-weight: 600; horizontal-alignment: left; wrap: word-wrap; }
        if root.detail != "": Text { text: root.detail; color: Theme.fg.with-alpha(0.588); font-size: 12px; horizontal-alignment: left; wrap: word-wrap; }
    }
    ctrl := HorizontalLayout {
        x: root.stack ? root.pad : root.width - root.pad - root.ctrl-w;
        y: root.stack ? txt.y + txt.preferred-height + 12px : (root.height - root.ctrl-h) / 2;
        width: root.ctrl-w; height: root.ctrl-h;
        @children
    }
    if !root.last: Rectangle { x: root.pad; y: root.height - 1px; width: root.width - 2 * root.pad; height: 1px; background: Theme.fg.with-alpha(0.063); }
}

// Botón tonal Material 3 (Configuración).
component TonalButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> danger: false;
    callback clicked();
    width: tb-text.preferred-width + 36px; height: 38px; border-radius: tb-ta.pressed ? 12px : 19px;
    property <color> base: root.danger ? #f2b8b5 : Theme.green-bright;
    background: tb-ta.pressed ? root.base.with-alpha(0.32) : (tb-ta.has-hover ? root.base.with-alpha(0.24) : root.base.with-alpha(0.16));
    opacity: root.enabled ? 1 : 0.45;
    animate background, border-radius { duration: 150ms; }
    tb-text := Text { text: root.text; color: root.base; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    accessible-role: button; accessible-label: root.text;
    tb-ta := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Pestaña de Configuración (riel lateral o chips arriba).
component SettingsTab inherits Rectangle {
    in property <string> icon-d;
    in property <string> label;
    in property <bool> selected;
    in property <bool> compact;
    callback clicked();
    height: root.compact ? 40px : 48px;
    width: root.compact ? st-row.preferred-width + 28px : 220px;
    border-radius: root.selected ? (root.compact ? 14px : 16px) : self.height / 2;
    background: root.selected ? Theme.green.with-alpha(0.26) : (st-ta.has-hover ? Theme.fg.with-alpha(0.063) : transparent);
    animate background, border-radius { duration: 180ms; easing: ease-out; }
    st-row := HorizontalLayout {
        padding-left: root.compact ? 14px : 18px; padding-right: 14px; spacing: 12px;
        alignment: start;
        IconPath { y: (parent.height - self.height) / 2; d: root.icon-d; width: 19px; height: 19px; tint: root.selected ? Theme.green-bright : Theme.fg.with-alpha(0.690); }
        Text { text: root.label; color: root.selected ? Theme.green-bright : Theme.fg.with-alpha(0.816); font-size: 14px; font-weight: root.selected ? 700 : 600; vertical-alignment: center; }
    }
    accessible-role: tab; accessible-label: root.label;
    st-ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component SwitchBox inherits Rectangle {
    in-out property <bool> on;
    callback toggled();
    width: 46px; height: 26px; border-radius: 13px;
    background: root.on ? Theme.green : Theme.fg.with-alpha(0.200);
    animate background { duration: 130ms; }
    Rectangle {
        x: root.on ? 22px : 2px; y: 3px; width: 20px; height: 20px; border-radius: 10px; background: white;
        animate x { duration: 130ms; easing: ease-out; }
    }
    accessible-role: checkbox;
    TouchArea { clicked => { root.on = !root.on; root.toggled(); } }
}

component SectionTitle inherits Text {
    color: Theme.fg; font-family: Theme.display-font; font-size: 22px; font-weight: 700; letter-spacing: -0.3px; horizontal-alignment: left;
}

component LinkText inherits Text {
    in property <color> link-color: Theme.sub;
    callback clicked();
    color: link-touch.has-hover ? Theme.fg : root.link-color; font-size: 13px; font-weight: 700; horizontal-alignment: left;
    link-touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component ReleaseCard inherits Rectangle {
    in property <CardEntry> entry;
    callback clicked();
    height: 112px; border-radius: 8px; background: release-touch.has-hover ? Theme.fg.with-alpha(0.110) : Theme.fg.with-alpha(0.051);
    HorizontalLayout { padding: 12px; spacing: 16px;
        Cover { width: 88px; height: 88px; source: root.entry.cover; corner: 5px; }
        VerticalLayout { alignment: center; spacing: 6px;
            Text { text: root.entry.title; color: Theme.fg; font-size: 17px; font-weight: 700; horizontal-alignment: left; overflow: elide; }
            Text { text: root.entry.subtitle; color: Theme.sub; font-size: 13px; horizontal-alignment: left; overflow: elide; }
        }
    }
    release-touch := TouchArea { clicked => { root.clicked(); } }
}

// Letra sincronizada con traducción opcional debajo de cada línea (misma animación que la original).
component LyricsView inherits Rectangle {
    in property <[LyricEntry]> rows;
    in property <int> active: -1;
    in property <bool> synced;
    in property <string> provider;
    in property <string> message;
    in property <bool> show-translation;
    in property <bool> has-translation;
    in property <bool> same-language;
    in property <bool> translating;
    // Color de acento de la portada: tiñe la línea traducida.
    in property <color> accent: white;
    // Versión estrecha para el panel lateral.
    in property <bool> compact: false;
    callback seek(int);
    callback toggle-translation();
    property <bool> dual: root.show-translation && root.has-translation;
    // Altura mínima de cada línea; crece si el texto (o su traducción) ocupa varias líneas.
    property <length> row-min: root.compact ? (root.dual ? 76px : 52px) : (root.dual ? 112px : 84px);
    property <length> row-pad: root.compact ? (root.dual ? 8px : 6px) : (root.dual ? 12px : 10px);
    // Posición (dentro del scroll) de la línea que suena: la fila activa la publica.
    property <length> active-y: 0px;
    property <length> main-font: root.compact ? 18px : 26px;
    property <length> tr-font: root.compact ? 14px : 19px;
    property <color> tr-color: root.accent.mix(white, 0.72);
    clip: true;

    if root.message != "": Text {
        x: 8px; y: 56px; width: parent.width - 16px; height: 50px;
        text: root.message; font-size: root.compact ? 14px : 16px; color: Theme.fg.with-alpha(0.667); wrap: word-wrap;
    }
    if root.rows.length > 0: ScrollView {
        x: 0; y: 0; width: parent.width; height: parent.height;
        horizontal-scrollbar-policy: always-off;
        content-y: root.active < 0 ? 0px : 0px - max(0px, root.active-y - self.height * 0.38);
        animate content-y { duration: 400ms; easing: ease-in-out; }
        VerticalLayout {
            padding-top: 52px; padding-bottom: 56px; padding-left: 8px;
            spacing: root.dual ? (root.compact ? 22px : 26px) : (root.compact ? 6px : 8px);
            for row[i] in root.rows: row-box := Rectangle {
                property <bool> is-active: i == root.active;
                property <bool> is-past: root.synced && i < root.active;
                height: max(root.row-min, row-vl.preferred-height);
                changed is-active => { if self.is-active { root.active-y = self.y; } }
                changed y => { if self.is-active { root.active-y = self.y; } }
                // Duetos (como Apple Music): la otra voz se alinea a la derecha.
                property <TextHorizontalAlignment> align: row.right ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                row-vl := VerticalLayout {
                    width: parent.width;
                    alignment: center;
                    spacing: root.compact ? (root.dual ? 6px : 3px) : (root.dual ? 8px : 6px);
                    padding-right: row.right ? 16px : 12px;
                    padding-left: row.right && !root.compact ? 64px : (row.right ? 28px : 0px);
                    padding-top: root.row-pad; padding-bottom: root.row-pad;
                    Text {
                        text: row.text; wrap: word-wrap;
                        horizontal-alignment: row-box.align; vertical-alignment: center;
                        font-family: Theme.display-font;
                        font-size: root.main-font;
                        font-weight: 700;
                        color: root.synced ? (is-active ? Theme.fg : (is-past ? Theme.fg.with-alpha(0.251) : Theme.fg.with-alpha(0.459))) : Theme.fg.with-alpha(0.867);
                        animate color { duration: 350ms; easing: ease-in-out; }
                    }
                    // Coros de fondo, más pequeños y tenues.
                    if row.bg != "": Text {
                        text: row.bg; wrap: word-wrap;
                        horizontal-alignment: row-box.align; vertical-alignment: center;
                        font-family: Theme.display-font;
                        font-size: root.main-font * 0.62;
                        font-weight: 600;
                        color: root.synced ? (is-active ? Theme.fg.with-alpha(0.75) : Theme.fg.with-alpha(0.32)) : Theme.fg.with-alpha(0.6);
                        animate color { duration: 350ms; easing: ease-in-out; }
                    }
                    if root.dual && row.translation != "": Text {
                        text: row.translation; wrap: word-wrap;
                        horizontal-alignment: row-box.align; vertical-alignment: center;
                        font-size: root.tr-font;
                        font-weight: 600;
                        color: root.tr-color;
                        opacity: !root.synced ? 0.85 : (is-active ? 0.95 : (is-past ? 0.35 : 0.55));
                        animate opacity { duration: 350ms; easing: ease-in-out; }
                    }
                }
                TouchArea { width: parent.width; height: parent.height; enabled: root.synced; clicked => { root.seek(i); } }
            }
            if root.provider != "": Rectangle {
                height: 44px;
                Text {
                    x: 0px; width: parent.width - 12px; height: parent.height;
                    text: "Letra: " + root.provider + (root.dual ? " · Traducción: Google" : "");
                    font-size: 12px; color: Theme.fg.with-alpha(0.400); vertical-alignment: center; wrap: word-wrap;
                }
            }
        }
    }
    // Conmutador «ES»: cápsula de cristal arriba a la derecha.
    if root.rows.length > 0 && root.show-translation && root.same-language: Text {
        x: parent.width - self.width - tr-pill.width - 18px; y: 14px; height: 24px;
        text: "Ya está en español"; font-size: 11px; color: Theme.fg.with-alpha(0.600); vertical-alignment: center;
    }
    tr-pill := Rectangle {
        visible: root.rows.length > 0;
        x: parent.width - self.width - 8px; y: 8px;
        width: tr-lay.preferred-width; height: 32px; border-radius: 16px;
        background: root.show-translation ? root.accent.with-alpha(0.34) : (tr-ta.has-hover ? Theme.fg.with-alpha(0.180) : Theme.fg.with-alpha(0.102));
        border-width: 1px;
        border-color: root.show-translation ? root.accent.mix(white, 0.4).with-alpha(0.7) : Theme.fg.with-alpha(0.200);
        drop-shadow-blur: 14px; drop-shadow-color: #00000055;
        animate background { duration: 160ms; }
        tr-lay := HorizontalLayout {
            padding-left: 10px; padding-right: 12px; spacing: 6px; alignment: center;
            IconPath { d: Icons.translate; width: 16px; height: 16px; tint: Theme.fg; y: (parent.height - self.height) / 2; }
            Text { text: root.translating ? "ES…" : "ES"; color: Theme.fg; font-size: 12px; font-weight: 700; vertical-alignment: center; }
        }
        accessible-role: button;
        accessible-label: root.show-translation ? "Ocultar traducción" : "Traducir letra al español";
        tr-ta := TouchArea { mouse-cursor: pointer; clicked => { root.toggle-translation(); } }
    }
}

// Lista de la cola (panel lateral y reproductor grande).
// Clic en una canción: suena ya. Asa ⠿ de la izquierda: arrastrar para colocarla donde se quiera.
// Al pasar el ratón: subir, bajar y quitar.
component QueueList inherits VerticalLayout {
    in property <[QueueRow]> rows;
    in property <bool> editable;
    in property <string> title;
    in property <string> artist;
    in property <image> cover;
    in property <color> accent: white;
    in property <bool> compact: false;
    callback remove(int);
    callback top(int);
    callback play(int);
    callback move(int, int);
    property <length> row-h: root.compact ? 56px : 66px;
    // Arrastre en curso: fila de origen (-1 si ninguno) y desplazamiento vertical del ratón.
    property <int> drag-from: -1;
    property <length> drag-dy: 0px;
    property <int> drag-to: root.drag-from < 0 ? -1 : max(0, min(root.rows.length - 1, root.drag-from + round(root.drag-dy / root.row-h)));
    spacing: 8px;
    Text { height: 22px; text: "Ahora suena"; font-size: root.compact ? 15px : 18px; font-weight: 700; color: Theme.fg; }
    Rectangle {
        height: root.compact ? 60px : 72px; border-radius: 8px; background: Theme.fg.with-alpha(0.063); border-width: 1px; border-color: root.accent.with-alpha(0.24);
        HorizontalLayout {
            padding: 8px; spacing: 10px;
            Rectangle { width: root.compact ? 44px : 52px; height: self.width; y: (parent.height - self.height) / 2; border-radius: 4px; clip: true; Image { width: 100%; height: 100%; source: root.cover; image-fit: ImageFit.cover; } }
            VerticalLayout {
                alignment: center; horizontal-stretch: 1;
                Text { text: root.title; font-size: root.compact ? 14px : 15px; font-weight: 700; color: root.accent.mix(white, 0.5); overflow: elide; }
                Text { text: root.artist; font-size: 12px; color: Theme.fg.with-alpha(0.667); overflow: elide; }
            }
        }
    }
    HorizontalLayout {
        height: 28px;
        Text { text: "A continuación"; font-size: root.compact ? 15px : 18px; font-weight: 700; color: Theme.fg; vertical-alignment: bottom; }
        Rectangle { horizontal-stretch: 1; }
        Text { text: root.rows.length == 0 ? "" : "\{root.rows.length} canciones"; font-size: 12px; color: Theme.fg.with-alpha(0.600); vertical-alignment: bottom; }
    }
    if root.rows.length == 0: Text { height: 50px; text: "No hay nada en la cola."; color: Theme.fg.with-alpha(0.600); font-size: 14px; }
    ListView {
        vertical-stretch: 1;
        for r[i] in root.rows: Rectangle {
            property <bool> dragging: root.drag-from == i;
            // Secciones como en Spotify: lo añadido a mano, lo que sigue del contexto y el autoplay.
            property <bool> header: i == 0 || root.rows[i - 1].tag != r.tag;
            property <length> header-h: self.header && !(i == 0 && r.tag == "") ? 34px : 0px;
            height: root.row-h + self.header-h;
            if (i == 0 || root.rows[i - 1].tag != r.tag) && !(i == 0 && r.tag == ""): Text {
                x: 4px; y: 6px; height: 24px;
                text: r.tag == "EN COLA" ? "Siguiente en la cola" : (r.tag == "AUTOPLAY" ? "Recomendado por Spotify" : "Siguiente de la lista");
                font-size: 13px; font-weight: 700; color: r.tag == "AUTOPLAY" ? root.accent.mix(white, 0.6) : Theme.fg.with-alpha(0.800);
                vertical-alignment: center;
            }
            // Línea verde donde caerá la canción arrastrada.
            if root.drag-to == i && root.drag-from >= 0 && root.drag-from != i: Rectangle {
                x: 6px; width: parent.width - 12px; height: 2px; border-radius: 1px; background: Theme.green-bright;
                y: root.drag-to > root.drag-from ? parent.height - 2px : parent.header-h;
            }
            q-row := TouchArea {
                y: parent.header-h; width: 100%; height: root.row-h;
                mouse-cursor: pointer;
                clicked => { root.play(i); }
                Rectangle {
                    y: root.drag-from == i ? root.drag-dy : 0px;
                    width: parent.width; height: parent.height; border-radius: 6px;
                    background: root.drag-from == i ? Theme.fg.with-alpha(0.149) : (q-row.has-hover ? Theme.fg.with-alpha(0.071) : transparent);
                    drop-shadow-blur: root.drag-from == i ? 14px : 0px; drop-shadow-color: #00000088;
                    HorizontalLayout {
                        padding-left: 2px; padding-right: 6px; spacing: 8px;
                        // Asa de arrastre.
                        Rectangle {
                            width: 22px;
                            visible: root.editable;
                            Text { text: "⠿"; color: handle-ta.has-hover || root.drag-from == i ? Theme.fg : Theme.fg.with-alpha(0.333); font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
                            handle-ta := TouchArea {
                                mouse-cursor: root.drag-from == i ? grabbing : grab;
                                pointer-event(e) => {
                                    if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                                        root.drag-from = i;
                                        root.drag-dy = 0px;
                                    } else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                                        if root.drag-from == i && root.drag-to >= 0 && root.drag-to != i {
                                            root.move(i, root.drag-to);
                                        }
                                        root.drag-from = -1;
                                        root.drag-dy = 0px;
                                    }
                                }
                                moved => {
                                    if self.pressed && root.drag-from == i { root.drag-dy = self.mouse-y - self.pressed-y; }
                                }
                            }
                        }
                        if !root.compact: Text { width: 22px; text: "\{i + 1}"; font-size: 13px; color: Theme.fg.with-alpha(0.502); vertical-alignment: center; horizontal-alignment: right; }
                        Rectangle {
                            width: root.compact ? 40px : 42px; height: self.width; border-radius: 4px; clip: true; background: Theme.fg.with-alpha(0.071); y: (parent.height - self.height) / 2;
                            Image { width: 100%; height: 100%; source: r.cover; image-fit: ImageFit.cover; }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1; alignment: center;
                            Text { text: r.title; font-size: root.compact ? 13px : 15px; font-weight: 600; color: Theme.fg; overflow: elide; }
                            Text { text: r.artist; font-size: 12px; color: Theme.fg.with-alpha(0.667); overflow: elide; }
                        }
                        if !(q-row.has-hover && root.editable): Text { text: r.duration; font-size: 12px; color: Theme.fg.with-alpha(0.600); vertical-alignment: center; }
                        if q-row.has-hover && root.editable && root.drag-from < 0: HorizontalLayout {
                            spacing: 0px;
                            RoundIconButton { d: Icons.up; width: 26px; height: 26px; icon-size: 15px; y: (parent.height - self.height) / 2; enabled: i > 0; label: "Subir"; clicked => { root.move(i, i - 1); } }
                            RoundIconButton { d: Icons.chevron-down; width: 26px; height: 26px; icon-size: 15px; y: (parent.height - self.height) / 2; enabled: i < root.rows.length - 1; label: "Bajar"; clicked => { root.move(i, i + 1); } }
                            RoundIconButton { d: Icons.close; width: 26px; height: 26px; icon-size: 14px; y: (parent.height - self.height) / 2; label: "Quitar de la cola"; clicked => { root.remove(i); } }
                        }
                    }
                }
            }
        }
    }
    if root.rows.length > 0: Text {
        height: 20px; font-size: 11px; color: Theme.fg.with-alpha(0.439);
        text: root.editable ? "Clic para reproducir · arrastra ⠿ para ordenar" : "Clic para reproducir";
    }
}

// «Mejor resultado» de la búsqueda.
component TopResultCard inherits Rectangle {
    in property <CardEntry> entry;
    in property <bool> round;
    in property <string> kind;
    callback clicked();
    callback play();
    height: 232px; border-radius: 10px;
    background: top-ta.has-hover ? Theme.fg.with-alpha(0.122) : Theme.fg.with-alpha(0.071);
    animate background { duration: 150ms; }
    top-ta := TouchArea {
    width: 100%; height: 100%;
    clicked => { root.clicked(); }
    Cover { x: 20px; y: 20px; width: 96px; height: 96px; corner: root.round ? 48px : 6px; source: root.entry.cover; }
    Text {
        x: 20px; y: 132px; width: parent.width - 40px;
        text: root.entry.title; font-family: Theme.display-font; font-size: 30px; font-weight: 800; letter-spacing: -0.8px;
        color: Theme.fg; overflow: elide; horizontal-alignment: left;
    }
    HorizontalLayout {
        x: 20px; y: 182px; height: 26px; spacing: 8px; alignment: start;
        Rectangle {
            width: kind-text.preferred-width + 20px; height: 26px; border-radius: 13px; background: #00000066;
            kind-text := Text { text: root.kind; color: Theme.fg; font-size: 12px; font-weight: 700; }
        }
        Text { text: root.entry.subtitle; color: Theme.sub; font-size: 13px; vertical-alignment: center; overflow: elide; }
    }
    if top-ta.has-hover: Rectangle {
        x: parent.width - 72px; y: parent.height - 72px; width: 52px; height: 52px; border-radius: 26px;
        background: play-ta.has-hover ? Theme.green-bright : Theme.green;
        drop-shadow-blur: 12px; drop-shadow-color: #00000088;
        IconPath { d: "M7 4.5 L19.5 12 L7 19.5 Z"; solid: true; tint: black; width: 20px; height: 20px; x: 17px; y: 16px; }
        play-ta := TouchArea { mouse-cursor: pointer; clicked => { root.play(); } }
    }
    }
}

// Tarjetas circulares de artista con botón de reproducción.
component ArtistGrid inherits Rectangle {
    in property <[CardEntry]> cards;
    callback clicked(int);
    callback play(int);
    property <int> cols: max(1, floor(self.width / 180px));
    property <length> cell: (self.width - (self.cols - 1) * 16px) / self.cols;
    height: ceil(root.cards.length / self.cols) * (self.cell + 70px);
    for card[i] in root.cards: Rectangle {
        x: mod(i, root.cols) * (root.cell + 16px);
        y: floor(i / root.cols) * (root.cell + 70px);
        width: root.cell; height: root.cell + 62px; border-radius: 8px;
        background: a-ta.has-hover ? Theme.fg.with-alpha(0.086) : transparent;
        a-ta := TouchArea {
        width: 100%; height: 100%;
        clicked => { root.clicked(i); }
        Cover { x: 10px; y: 10px; width: parent.width - 20px; height: self.width; corner: self.width / 2; fallback: Theme.hover; source: card.cover; }
        Text { x: 10px; y: root.cell; width: parent.width - 20px; text: card.title; font-size: 14px; font-weight: 700; color: Theme.fg; overflow: elide; horizontal-alignment: center; }
        Text { x: 10px; y: root.cell + 22px; width: parent.width - 20px; text: card.subtitle; font-size: 12px; color: Theme.sub; overflow: elide; horizontal-alignment: center; }
        if a-ta.has-hover: Rectangle {
            x: parent.width - 62px; y: root.cell - 62px; width: 44px; height: 44px; border-radius: 22px;
            background: ap-ta.has-hover ? Theme.green-bright : Theme.green;
            drop-shadow-blur: 10px; drop-shadow-color: #00000088;
            IconPath { d: "M7 4.5 L19.5 12 L7 19.5 Z"; solid: true; tint: black; width: 16px; height: 16px; x: 15px; y: 14px; }
            ap-ta := TouchArea { mouse-cursor: pointer; clicked => { root.play(i); } }
        }
        }
    }
}

// Cuadrícula de géneros con degradados (cuando aún no se ha escrito nada).
component GenreGrid inherits Rectangle {
    in property <[GenreEntry]> genres;
    callback clicked(string);
    property <int> cols: max(2, floor(self.width / 200px));
    property <length> cell: (self.width - (self.cols - 1) * 16px) / self.cols;
    height: ceil(root.genres.length / self.cols) * 116px;
    for g[i] in root.genres: Rectangle {
        x: mod(i, root.cols) * (root.cell + 16px);
        y: floor(i / root.cols) * 116px;
        width: root.cell; height: 100px; border-radius: 10px; clip: true;
        background: @linear-gradient(135deg, g.from 0%, g.to 100%);
        Rectangle { background: g-ta.has-hover ? Theme.fg.with-alpha(0.110) : transparent; animate background { duration: 120ms; } }
        Text { x: 16px; y: 14px; width: parent.width - 32px; text: g.name; color: Theme.fg; font-family: Theme.display-font; font-size: 21px; font-weight: 800; wrap: word-wrap; horizontal-alignment: left; }
        Rectangle { x: parent.width - 58px; y: 50px; width: 80px; height: 80px; border-radius: 40px; background: Theme.fg.with-alpha(0.118); }
        g-ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(g.query); } }
    }
}

export component MainWindow inherits Window {
    title: "SpotifyMac";
    // En macOS se conserva el marco nativo: con `no-frame` Slint quitaba la decoración en cada
    // actualización de la ventana y los botones de cerrar/minimizar/ampliar desaparecían.
    no-frame: !root.is-macos;
    min-width: 960px;
    min-height: 620px;
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Theme.side;
    default-font-family: Theme.text-font;

    // ---- Estado que rellena Rust ----
    in property <[LibraryEntry]> library;
    in property <[CardEntry]> home-cards;
    in property <[CardEntry]> made-cards;
    in property <[CardEntry]> mix-cards;
    in property <string> home-message: "Cargando tu Inicio…";
    callback open-section(int, int);
    callback refresh-home();
    in property <image> list-cover;
    in property <image> list-cover-blur;
    in property <image> list-banner;
    in property <bool> has-list-banner;
    in property <bool> list-editorial;
    // Fondo del perfil: el color de la foto del artista, algo más oscuro hacia abajo.
    property <color> artist-base: root.is-light ? root.th-list-tint : root.th-list-tint.mix(#101116, 0.3);
    property <length> sidebar-width: root.sidebar-visible ? (root.width < 1100px ? 236px : 280px) : 0px;
    property <bool> wide-artist: root.width >= 1250px;
    property <int> disco-tab: root.artist-catalog-tab == 0 && root.catalog-albums.length > 0 ? 0
        : root.artist-catalog-tab == 1 && root.catalog-singles.length > 0 ? 1
        : root.artist-catalog-tab == 2 && root.catalog-collabs.length > 0 ? 2
        : root.catalog-albums.length > 0 ? 0 : root.catalog-singles.length > 0 ? 1 : 2;
    in property <color> list-tint: #292d3e;
    in property <color> list-pill: #424862;
    in property <color> list-accent: #ebebeb;
    property <color> list-btn-accent: root.th-list-accent;
    property <color> list-icon-tint: root.th-list-accent;
    in property <color> artist-accent: #bebebe;
    in property <string> list-kind: "PLAYLIST";
    in property <string> list-description;
    in property <string> list-summary;
    in property <string> list-message;
    in property <image> list-artist-avatar;
    in property <string> list-header-artist;
    in property <bool> list-header-artist-clickable;
    in property <string> list-tracks-chip;
    in property <string> list-duration-chip;
    callback play-list();
    in-out property <length> menu-x: 300px;
    in-out property <length> menu-y: 180px;
    in-out property <int> detail-panel;
    in-out property <length> list-scroll;
    in-out property <length> artist-scroll;
    in-out property <length> profile-scroll;
    in property <image> motion-frame;
    in property <bool> motion-ready;
    in property <image> track-motion-frame;
    in property <bool> track-motion-ready;
    in property <bool> track-explicit;
    in property <[LyricEntry]> lyric-rows;
    in property <bool> lyrics-synced;
    in property <string> lyrics-provider;
    in property <string> lyrics-message;
    in-out property <bool> lyrics-open;
    in property <int> lyric-active: -1;
    callback toggle-lyrics();
    callback seek-lyric(int);
    // ---- Traducción de letras ----
    in property <bool> lyrics-has-translation;
    in property <bool> lyrics-same-language;
    in property <bool> lyrics-translating;
    in-out property <bool> show-translation;
    callback toggle-translation();
    // ---- Panel lateral derecho: 0 cerrado · 1 letra · 2 cola ----
    in-out property <int> right-panel: 0;
    // La barra izquierda se ocultó sola al abrir el panel derecho en una ventana estrecha.
    in-out property <bool> sidebar-auto-hidden;
    property <length> right-panel-width: root.right-panel != 0 ? (root.width < 1250px ? 330px : 380px) : 0px;
    callback ensure-lyrics();
    // Letra o cola: si ya estaba abierta esa misma, se cierra; si estaba la otra, se cambia sin cerrar.
    public function toggle-right-panel(which: int) {
        root.right-panel = root.right-panel == which ? 0 : which;
        if root.right-panel != 0 && root.width < 1050px && root.sidebar-visible {
            root.sidebar-visible = false;
            root.sidebar-auto-hidden = true;
        }
        if root.right-panel == 0 && root.sidebar-auto-hidden {
            root.sidebar-visible = true;
            root.sidebar-auto-hidden = false;
        }
        if root.right-panel == 1 { root.ensure-lyrics(); }
    }
    // ---- Reproductor a pantalla completa: los controles se ocultan tras 2 s sin mover el ratón ----
    in-out property <bool> np-controls-visible: true;
    in-out property <bool> np-hover-controls;
    in-out property <bool> np-hover-pill;
    in-out property <bool> np-hover-close;
    in-out property <bool> np-cover-expanded: false;
    in-out property <bool> infinite-queue: true;
    callback toggle-infinite-queue();
    callback np-activity();
    callback open-now-playing();
    callback close-now-playing();
    in property <image> artist-logo;
    in property <bool> has-artist-logo;
    in-out property <bool> motion-paused;
    in-out property <int> artist-catalog-tab;
    callback toggle-motion();
    callback sync-page-motion(bool);
    in property <bool> list-is-album;
    in property <bool> list-can-pin;
    in property <bool> list-pinned;
    in property <[CardEntry]> catalog-albums;
    in property <[CardEntry]> catalog-singles;
    in property <[CardEntry]> catalog-collabs;
