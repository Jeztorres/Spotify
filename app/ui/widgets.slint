import { Theme } from "theme.slint";

// Iconos dibujados con rutas vectoriales (en macOS eran SF Symbols).
export component IconPath inherits Path {
    in property <string> d;
    in property <color> tint: Theme.fg;
    // `solid`: silueta rellena (p. ej. el triángulo de play); por defecto, icono de línea.
    in property <bool> solid: false;
    width: 18px;
    height: 18px;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: d;
    fill: root.solid ? root.tint : transparent;
    stroke: root.solid ? transparent : root.tint;
    stroke-width: root.solid ? 0px : max(1.5px, root.width * 1.9 / 24);
    stroke-line-cap: round;
    stroke-line-join: round;
}

export component PlayPauseButton inherits Rectangle {
    in property <bool> playing;
    in property <color> accent: #ebebeb;
    in property <color> icon-color: black;
    in property <bool> enabled: true;
    opacity: root.enabled ? 1 : 0.4;
    callback clicked();
    width: 36px;
    height: 36px;
    border-radius: self.height / 2;
    background: ta.has-hover ? root.accent.brighter(0.15) : root.accent;
    drop-shadow-blur: ta.has-hover ? 14px : 6px;
    drop-shadow-color: root.accent.with-alpha(0.35);
    animate background, drop-shadow-blur { duration: 140ms; easing: ease-out; }

    if !root.playing: IconPath {
        d: "M7 4.5 L19.5 12 L7 19.5 Z";
        tint: root.icon-color;
        solid: true;
        width: 16px;
        height: 16px;
        x: (parent.width - self.width) / 2 + 1px;
        y: (parent.height - self.height) / 2;
    }
    if root.playing: Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 12px;
        height: 14px;
        Rectangle { x: 0; width: 4px; height: 14px; background: root.icon-color; border-radius: 2px; }
        Rectangle { x: 8px; width: 4px; height: 14px; background: root.icon-color; border-radius: 2px; }
    }
    ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

export component RoundIconButton inherits Rectangle {
    in property <color> active-color: Theme.green-bright;
    in property <color> icon-color: Theme.sub;
    in property <color> bg-color: Theme.light ? #e4e4ea : #26262a;
    in property <length> icon-size: 18px;
    in property <bool> enabled: true;
    opacity: root.enabled ? 1 : 0.4;
    in property <string> d;
    in property <bool> active: false;
    in property <string> label;
    in property <string> badge;
    callback clicked();
    width: 34px;
    height: 34px;
    // `flat`: sin círculo de fondo; solo el icono teñido y un halo suave al pasar el ratón.
    in property <bool> flat: false;
    in property <color> hover-icon-color: Theme.fg;
    in property <color> hover-bg: Theme.fg.with-alpha(0.122);
    border-radius: self.height / 2;
    background: root.flat
        ? (ta.pressed ? root.hover-bg.with-alpha(root.hover-bg.alpha * 1.7) : (ta.has-hover ? root.hover-bg : (root.active ? root.active-color.with-alpha(0.14) : transparent)))
        : root.active
        ? (ta.pressed ? root.bg-color.brighter(0.45) : (ta.has-hover ? root.bg-color.brighter(0.35) : root.bg-color.brighter(0.25)))
        : (ta.pressed ? root.bg-color.brighter(0.25) : (ta.has-hover ? root.bg-color.brighter(0.15) : root.bg-color));
    border-width: root.flat ? 0px : 1px;
    border-color: root.active ? root.active-color : root.bg-color.brighter(0.28);
    animate background { duration: 130ms; easing: ease-out; }
    IconPath {
        d: root.d;
        tint: root.active ? root.active-color : (ta.has-hover ? root.hover-icon-color : root.icon-color);
        width: root.icon-size;
        height: root.icon-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        animate tint { duration: 120ms; }
    }
    if root.active: Rectangle { x: (parent.width - 4px) / 2; y: parent.height - 3px; width: 4px; height: 4px; border-radius: 2px; background: root.active-color; }
    if root.badge != "": Text { text: root.badge; color: root.active-color; font-size: 9px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
    accessible-role: button;
    accessible-label: root.label;
    ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

// Barra de progreso / volumen: toma el color de la portada y se aclara al pasar el ratón.
export component Scrubber inherits Rectangle {
    in-out property <float> value: 0;
    in property <color> bar-color: Theme.fg;
    in property <color> accent: Theme.green-bright;
    in property <color> track-color: Theme.fg.with-alpha(0.180);
    in property <float> marker-start: 1.0;
    in property <color> marker-color: Theme.green-bright;
    in property <bool> wavy: false;
    // Mueve la onda mientras suena (Material 3 Expressive).
    in property <bool> wave-moving: false;
    in property <color> thumb-color: root.bar-color;
    callback changed(float);
    height: root.wavy ? 20px : 14px;
    min-width: 60px;

    property <color> active-fill: root.value >= root.marker-start && root.marker-start < 0.999
        ? root.marker-color
        : (ta.has-hover || ta.pressed ? root.accent : root.bar-color);

    if !root.wavy: Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: root.track-color;
        if root.marker-start < 0.999: Rectangle {
            x: parent.width * clamp(root.marker-start, 0, 1);
            y: 0;
            height: parent.height;
            width: parent.width * (1 - clamp(root.marker-start, 0, 1));
            border-radius: 2px;
            background: root.marker-color.with-alpha(root.value >= root.marker-start ? 0.9 : 0.42);
        }
        Rectangle {
            x: 0;
            y: 0;
            height: parent.height;
            width: parent.width * clamp(root.value, 0, 1);
            border-radius: 2px;
            background: root.active-fill;
            animate background { duration: 180ms; }
        }
        if root.marker-start < 0.999: Rectangle {
            x: parent.width * clamp(root.marker-start, 0, 1) - 1px;
            y: (parent.height - self.height) / 2;
            width: 2px;
            height: 10px;
            border-radius: 1px;
            background: root.marker-color;
        }
        if ta.has-hover || ta.pressed: Rectangle {
            x: parent.width * clamp(root.value, 0, 1) - 6px;
            y: (parent.height - self.height) / 2;
            width: 12px;
            height: 12px;
            border-radius: 6px;
            background: root.thumb-color;
            drop-shadow-blur: 4px;
            drop-shadow-color: #00000055;
        }
    }

    if root.wavy: Rectangle {
        width: parent.width;
        height: parent.height;
        background: transparent;
        property <length> thumb-x: parent.width * clamp(root.value, 0, 1);
        property <length> gap: 6px;
        // Tramo restante plano y grueso (Material 3 Expressive)
        Rectangle {
            x: min(parent.width, thumb-x + gap);
            y: (parent.height - self.height) / 2;
            width: max(0px, parent.width - self.x);
            height: 5px;
            border-radius: 2.5px;
            background: root.track-color;
        }
        if root.marker-start < 0.999: Rectangle {
            x: max(parent.width * clamp(root.marker-start, 0, 1), thumb-x + gap);
            y: (parent.height - self.height) / 2;
            height: 5px;
            width: max(0px, parent.width - self.x);
            border-radius: 2.5px;
            background: root.marker-color.with-alpha(0.42);
        }
        // Tramo reproducido ondulado (Material 3): amplitud visible y trazo redondeado.
        Rectangle {
            x: 0;
            y: (parent.height - self.height) / 2;
            width: max(0px, thumb-x - gap);
            // 4px más que el viewbox: Slint encoge la ruta para que quepa el grosor del trazo.
            height: 24px;
            clip: true;
            // Una sola ruta del ancho exacto; la onda avanza moviendo `viewbox-x` (nunca una `x` negativa,
            // que el renderizador por software dibuja desplazada).
            Path {
                x: 0;
                y: 0;
                width: max(8px, parent.width);
                height: 24px;
                viewbox-x: root.wave-moving ? 16 - 16 * mod(animation-tick() / 1ms, 900) / 900 : 0;
                viewbox-y: 0;
                viewbox-width: self.width / 1px - 4;
                viewbox-height: 20;
                fill: transparent;
                stroke: root.active-fill;
                stroke-width: 4px;
                stroke-line-cap: round;
                stroke-line-join: round;
                commands: "M 0 10 Q 4 3 8 10 Q 12 17 16 10 Q 20 3 24 10 Q 28 17 32 10 Q 36 3 40 10 Q 44 17 48 10 Q 52 3 56 10 Q 60 17 64 10 Q 68 3 72 10 Q 76 17 80 10 Q 84 3 88 10 Q 92 17 96 10 Q 100 3 104 10 Q 108 17 112 10 Q 116 3 120 10 Q 124 17 128 10 Q 132 3 136 10 Q 140 17 144 10 Q 148 3 152 10 Q 156 17 160 10 Q 164 3 168 10 Q 172 17 176 10 Q 180 3 184 10 Q 188 17 192 10 Q 196 3 200 10 Q 204 17 208 10 Q 212 3 216 10 Q 220 17 224 10 Q 228 3 232 10 Q 236 17 240 10 Q 244 3 248 10 Q 252 17 256 10 Q 260 3 264 10 Q 268 17 272 10 Q 276 3 280 10 Q 284 17 288 10 Q 292 3 296 10 Q 300 17 304 10 Q 308 3 312 10 Q 316 17 320 10 Q 324 3 328 10 Q 332 17 336 10 Q 340 3 344 10 Q 348 17 352 10 Q 356 3 360 10 Q 364 17 368 10 Q 372 3 376 10 Q 380 17 384 10 Q 388 3 392 10 Q 396 17 400 10 Q 404 3 408 10 Q 412 17 416 10 Q 420 3 424 10 Q 428 17 432 10 Q 436 3 440 10 Q 444 17 448 10 Q 452 3 456 10 Q 460 17 464 10 Q 468 3 472 10 Q 476 17 480 10 Q 484 3 488 10 Q 492 17 496 10 Q 500 3 504 10 Q 508 17 512 10 Q 516 3 520 10 Q 524 17 528 10 Q 532 3 536 10 Q 540 17 544 10 Q 548 3 552 10 Q 556 17 560 10 Q 564 3 568 10 Q 572 17 576 10 Q 580 3 584 10 Q 588 17 592 10 Q 596 3 600 10 Q 604 17 608 10 Q 612 3 616 10 Q 620 17 624 10 Q 628 3 632 10 Q 636 17 640 10 Q 644 3 648 10 Q 652 17 656 10 Q 660 3 664 10 Q 668 17 672 10 Q 676 3 680 10 Q 684 17 688 10 Q 692 3 696 10 Q 700 17 704 10 Q 708 3 712 10 Q 716 17 720 10 Q 724 3 728 10 Q 732 17 736 10 Q 740 3 744 10 Q 748 17 752 10 Q 756 3 760 10 Q 764 17 768 10 Q 772 3 776 10 Q 780 17 784 10 Q 788 3 792 10 Q 796 17 800 10 Q 804 3 808 10 Q 812 17 816 10 Q 820 3 824 10 Q 828 17 832 10 Q 836 3 840 10 Q 844 17 848 10 Q 852 3 856 10 Q 860 17 864 10 Q 868 3 872 10 Q 876 17 880 10 Q 884 3 888 10 Q 892 17 896 10 Q 900 3 904 10 Q 908 17 912 10 Q 916 3 920 10 Q 924 17 928 10 Q 932 3 936 10 Q 940 17 944 10 Q 948 3 952 10 Q 956 17 960 10 Q 964 3 968 10 Q 972 17 976 10 Q 980 3 984 10 Q 988 17 992 10 Q 996 3 1000 10 Q 1004 17 1008 10 Q 1012 3 1016 10 Q 1020 17 1024 10 Q 1028 3 1032 10 Q 1036 17 1040 10 Q 1044 3 1048 10 Q 1052 17 1056 10 Q 1060 3 1064 10 Q 1068 17 1072 10 Q 1076 3 1080 10 Q 1084 17 1088 10 Q 1092 3 1096 10 Q 1100 17 1104 10 Q 1108 3 1112 10 Q 1116 17 1120 10 Q 1124 3 1128 10 Q 1132 17 1136 10 Q 1140 3 1144 10 Q 1148 17 1152 10 Q 1156 3 1160 10 Q 1164 17 1168 10 Q 1172 3 1176 10 Q 1180 17 1184 10 Q 1188 3 1192 10 Q 1196 17 1200 10 Q 1204 3 1208 10 Q 1212 17 1216 10 Q 1220 3 1224 10 Q 1228 17 1232 10 Q 1236 3 1240 10 Q 1244 17 1248 10 Q 1252 3 1256 10 Q 1260 17 1264 10 Q 1268 3 1272 10 Q 1276 17 1280 10 Q 1284 3 1288 10 Q 1292 17 1296 10 Q 1300 3 1304 10 Q 1308 17 1312 10 Q 1316 3 1320 10 Q 1324 17 1328 10 Q 1332 3 1336 10 Q 1340 17 1344 10 Q 1348 3 1352 10 Q 1356 17 1360 10 Q 1364 3 1368 10 Q 1372 17 1376 10 Q 1380 3 1384 10 Q 1388 17 1392 10 Q 1396 3 1400 10 Q 1404 17 1408 10 Q 1412 3 1416 10 Q 1420 17 1424 10 Q 1428 3 1432 10 Q 1436 17 1440 10 Q 1444 3 1448 10 Q 1452 17 1456 10 Q 1460 3 1464 10 Q 1468 17 1472 10 Q 1476 3 1480 10 Q 1484 17 1488 10 Q 1492 3 1496 10 Q 1500 17 1504 10 Q 1508 3 1512 10 Q 1516 17 1520 10 Q 1524 3 1528 10 Q 1532 17 1536 10 Q 1540 3 1544 10 Q 1548 17 1552 10 Q 1556 3 1560 10 Q 1564 17 1568 10 Q 1572 3 1576 10 Q 1580 17 1584 10 Q 1588 3 1592 10 Q 1596 17 1600 10 Q 1604 3 1608 10 Q 1612 17 1616 10 Q 1620 3 1624 10 Q 1628 17 1632 10 Q 1636 3 1640 10 Q 1644 17 1648 10 Q 1652 3 1656 10 Q 1660 17 1664 10 Q 1668 3 1672 10 Q 1676 17 1680 10 Q 1684 3 1688 10 Q 1692 17 1696 10 Q 1700 3 1704 10 Q 1708 17 1712 10 Q 1716 3 1720 10 Q 1724 17 1728 10 Q 1732 3 1736 10 Q 1740 17 1744 10 Q 1748 3 1752 10 Q 1756 17 1760 10 Q 1764 3 1768 10 Q 1772 17 1776 10 Q 1780 3 1784 10 Q 1788 17 1792 10 Q 1796 3 1800 10 Q 1804 17 1808 10 Q 1812 3 1816 10 Q 1820 17 1824 10 Q 1828 3 1832 10 Q 1836 17 1840 10 Q 1844 3 1848 10 Q 1852 17 1856 10 Q 1860 3 1864 10 Q 1868 17 1872 10 Q 1876 3 1880 10 Q 1884 17 1888 10 Q 1892 3 1896 10 Q 1900 17 1904 10 Q 1908 3 1912 10 Q 1916 17 1920 10 Q 1924 3 1928 10 Q 1932 17 1936 10 Q 1940 3 1944 10 Q 1948 17 1952 10 Q 1956 3 1960 10 Q 1964 17 1968 10 Q 1972 3 1976 10 Q 1980 17 1984 10 Q 1988 3 1992 10 Q 1996 17 2000 10 Q 2004 3 2008 10 Q 2012 17 2016 10 Q 2020 3 2024 10 Q 2028 17 2032 10 Q 2036 3 2040 10 Q 2044 17 2048 10 Q 2052 3 2056 10 Q 2060 17 2064 10 Q 2068 3 2072 10 Q 2076 17 2080 10 Q 2084 3 2088 10 Q 2092 17 2096 10 Q 2100 3 2104 10 Q 2108 17 2112 10 Q 2116 3 2120 10 Q 2124 17 2128 10 Q 2132 3 2136 10 Q 2140 17 2144 10 Q 2148 3 2152 10 Q 2156 17 2160 10 Q 2164 3 2168 10 Q 2172 17 2176 10 Q 2180 3 2184 10 Q 2188 17 2192 10 Q 2196 3 2200 10 Q 2204 17 2208 10 Q 2212 3 2216 10 Q 2220 17 2224 10 Q 2228 3 2232 10 Q 2236 17 2240 10 Q 2244 3 2248 10 Q 2252 17 2256 10 Q 2260 3 2264 10 Q 2268 17 2272 10 Q 2276 3 2280 10 Q 2284 17 2288 10 Q 2292 3 2296 10 Q 2300 17 2304 10 Q 2308 3 2312 10 Q 2316 17 2320 10 Q 2324 3 2328 10 Q 2332 17 2336 10 Q 2340 3 2344 10 Q 2348 17 2352 10 Q 2356 3 2360 10 Q 2364 17 2368 10 Q 2372 3 2376 10 Q 2380 17 2384 10 Q 2388 3 2392 10 Q 2396 17 2400 10 Q 2404 3 2408 10 Q 2412 17 2416 10 Q 2420 3 2424 10 Q 2428 17 2432 10 Q 2436 3 2440 10 Q 2444 17 2448 10 Q 2452 3 2456 10 Q 2460 17 2464 10 Q 2468 3 2472 10 Q 2476 17 2480 10 Q 2484 3 2488 10 Q 2492 17 2496 10 Q 2500 3 2504 10 Q 2508 17 2512 10 Q 2516 3 2520 10 Q 2524 17 2528 10 Q 2532 3 2536 10 Q 2540 17 2544 10 Q 2548 3 2552 10 Q 2556 17 2560 10 Q 2564 3 2568 10 Q 2572 17 2576 10 Q 2580 3 2584 10 Q 2588 17 2592 10 Q 2596 3 2600 10 Q 2604 17 2608 10 Q 2612 3 2616 10 Q 2620 17 2624 10 Q 2628 3 2632 10 Q 2636 17 2640 10 Q 2644 3 2648 10 Q 2652 17 2656 10 Q 2660 3 2664 10 Q 2668 17 2672 10 Q 2676 3 2680 10 Q 2684 17 2688 10 Q 2692 3 2696 10 Q 2700 17 2704 10 Q 2708 3 2712 10 Q 2716 17 2720 10 Q 2724 3 2728 10 Q 2732 17 2736 10 Q 2740 3 2744 10 Q 2748 17 2752 10 Q 2756 3 2760 10 Q 2764 17 2768 10 Q 2772 3 2776 10 Q 2780 17 2784 10 Q 2788 3 2792 10 Q 2796 17 2800 10 Q 2804 3 2808 10 Q 2812 17 2816 10 Q 2820 3 2824 10 Q 2828 17 2832 10 Q 2836 3 2840 10 Q 2844 17 2848 10 Q 2852 3 2856 10 Q 2860 17 2864 10 Q 2868 3 2872 10 Q 2876 17 2880 10 Q 2884 3 2888 10 Q 2892 17 2896 10 Q 2900 3 2904 10 Q 2908 17 2912 10 Q 2916 3 2920 10 Q 2924 17 2928 10 Q 2932 3 2936 10 Q 2940 17 2944 10 Q 2948 3 2952 10 Q 2956 17 2960 10 Q 2964 3 2968 10 Q 2972 17 2976 10 Q 2980 3 2984 10 Q 2988 17 2992 10 Q 2996 3 3000 10 Q 3004 17 3008 10";
            }
        }
        if root.marker-start < 0.999: Rectangle {
            x: parent.width * clamp(root.marker-start, 0, 1) - 1px;
            y: (parent.height - self.height) / 2;
            width: 2px;
            height: 10px;
            border-radius: 1px;
            background: root.marker-color;
        }
        // Indicador vertical redondeado (Material 3)
        Rectangle {
            x: clamp(thumb-x - 2.5px, 0px, parent.width - self.width);
            y: (parent.height - self.height) / 2;
            width: 5px;
            height: ta.has-hover || ta.pressed ? 20px : 16px;
            border-radius: 2.5px;
            background: root.thumb-color;
            animate height { duration: 120ms; }
        }
    }
    ta := TouchArea {
        function set-from(x: length) {
            root.value = clamp(x / root.width, 0, 1);
            root.changed(root.value);
        }
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down { set-from(self.mouse-x); }
        }
        moved => { if self.pressed { set-from(self.mouse-x); } }
    }
}

export component VerticalEqSlider inherits Rectangle {
    in-out property <float> value: 0.5;
    in property <bool> active: true;
    in property <color> accent: Theme.green-bright;
    callback changed(float);
    width: 32px;
    height: 112px;

    // Marca central (0 dB)
    Rectangle {
        x: 6px; y: parent.height / 2 - 0.5px;
        width: parent.width - 12px; height: 1px;
        background: Theme.fg.with-alpha(0.157);
    }
    // Pista vertical
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: 6px;
        width: 5px;
        height: parent.height - 12px;
        border-radius: 2.5px;
        background: Theme.fg.with-alpha(0.141);
        // Relleno desde abajo hasta el nivel
        Rectangle {
            x: 0;
            width: parent.width;
            height: parent.height * clamp(root.value, 0, 1);
            y: parent.height - self.height;
            border-radius: 2.5px;
            background: root.active ? (ta.has-hover || ta.pressed ? root.accent.brighter(0.15) : root.accent) : Theme.fg.with-alpha(0.333);
        }
    }
    // Perilla
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: 6px + (parent.height - 12px) * (1 - clamp(root.value, 0, 1)) - self.height / 2;
        width: ta.has-hover || ta.pressed ? 14px : 12px;
        height: self.width;
        border-radius: self.width / 2;
        background: root.active ? (Theme.light ? root.accent : white) : Theme.fg.with-alpha(0.533);
        animate width { duration: 120ms; }
    }
    ta := TouchArea {
        enabled: root.active;
        mouse-cursor: root.active ? pointer : default;
        function set-from(y: length) {
            root.value = clamp(1.0 - (y - 6px) / (root.height - 12px), 0, 1);
            root.changed(root.value);
        }
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down { set-from(self.mouse-y); }
        }
        moved => { if self.pressed { set-from(self.mouse-y); } }
    }
}

export component NavItem inherits Rectangle {
    in property <string> icon-d;
    in property <string> title;
    in property <bool> active;
    // Color del elemento activo (personalizable desde Ajustes).
    in property <color> accent: Theme.fg;
    callback clicked();
    height: 40px;
    border-radius: 8px;
    background: root.active ? root.accent.with-alpha(0.12) : (ta.has-hover ? Theme.fg.with-alpha(0.039) : transparent);
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 16px;
        alignment: start;
        IconPath {
            d: root.icon-d;
            tint: root.active ? root.accent : (ta.has-hover ? Theme.fg : Theme.sub);
            y: (parent.height - self.height) / 2;
            width: 22px;
            height: 22px;
        }
        Text {
            text: root.title;
            font-size: 15px;
            font-weight: 700;
            color: root.active ? root.accent : (ta.has-hover ? Theme.fg : Theme.sub);
            vertical-alignment: center;
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

export component Cover inherits Rectangle {
    in property <image> source;
    in property <brush> fallback: Theme.hover;
    in property <length> corner: 6px;
    border-radius: root.corner;
    background: root.fallback;
    clip: true;
    Image { source: root.source; width: 100%; height: 100%; image-fit: cover; }
}

// ---- Material 3 Expressive ----
// Botón de icono M3: contenedor tonal opcional, capa de estado al pasar/pulsar y forma que
// pasa de círculo a "squircle" al activarse o pulsarse.
export component M3IconButton inherits Rectangle {
    in property <string> d;
    in property <bool> solid: false;
    in property <bool> active: false;
    in property <bool> tonal: true;
    in property <bool> enabled: true;
    in property <color> container: Theme.fg.with-alpha(0.102);
    in property <color> active-container: white;
    in property <color> icon-color: Theme.fg;
    in property <color> active-icon-color: black;
    in property <length> icon-size: 22px;
    in property <string> label;
    in property <string> badge;
    callback clicked();
    width: 48px;
    height: 48px;
    opacity: root.enabled ? 1 : 0.4;
    border-radius: ta.pressed ? self.height * 0.26 : (root.active ? self.height * 0.32 : self.height / 2);
    background: root.active ? root.active-container : (root.tonal ? root.container : transparent);
    animate border-radius { duration: 240ms; easing: ease-out; }
    animate background { duration: 160ms; }
    // Capa de estado (hover / pulsado).
    Rectangle {
        border-radius: parent.border-radius;
        background: ta.pressed ? (root.active ? #00000029 : Theme.fg.with-alpha(0.161)) : (ta.has-hover ? (root.active ? #00000014 : Theme.fg.with-alpha(0.090)) : transparent);
        animate background { duration: 120ms; }
    }
    IconPath {
        d: root.d;
        solid: root.solid;
        tint: root.active ? root.active-icon-color : root.icon-color;
        width: root.icon-size;
        height: root.icon-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        animate tint { duration: 160ms; }
    }
    if root.badge != "": Rectangle {
        x: parent.width - 16px; y: 4px; width: 14px; height: 14px; border-radius: 7px;
        background: root.active ? root.active-icon-color : root.icon-color;
        Text { text: root.badge; color: (root.active ? root.active-icon-color : root.icon-color).red * 0.299 + (root.active ? root.active-icon-color : root.icon-color).green * 0.587 + (root.active ? root.active-icon-color : root.icon-color).blue * 0.114 > 150 ? #121214 : white; font-size: 9px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
    }
    accessible-role: button;
    accessible-label: root.label;
    ta := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Play/pausa M3 Expressive: cápsula ancha en pausa que se transforma en "squircle" al sonar.
export component M3PlayButton inherits Rectangle {
    in property <bool> playing;
    in property <bool> enabled: true;
    in property <color> container: white;
    in property <color> icon-color: black;
    in property <length> size: 68px;
    callback clicked();
    height: root.size;
    width: root.playing ? root.size * 1.12 : root.size * 1.34;
    border-radius: ta.pressed ? root.size * 0.22 : (root.playing ? root.size * 0.32 : root.size / 2);
    background: root.container;
    opacity: root.enabled ? 1 : 0.4;
    drop-shadow-blur: ta.has-hover ? 22px : 14px;
    drop-shadow-color: root.container.with-alpha(0.35);
    animate width, border-radius { duration: 280ms; easing: ease-in-out; }
    animate drop-shadow-blur { duration: 160ms; }
    Rectangle {
        border-radius: parent.border-radius;
        background: ta.pressed ? #00000029 : (ta.has-hover ? #00000012 : transparent);
    }
    if !root.playing: IconPath {
        d: "M7 4.5 C7 3.7 7.9 3.2 8.6 3.6 L19.6 11.1 C20.2 11.5 20.2 12.5 19.6 12.9 L8.6 20.4 C7.9 20.8 7 20.3 7 19.5 Z";
        solid: true;
        tint: root.icon-color;
        width: root.size * 0.42;
        height: root.size * 0.42;
        x: (parent.width - self.width) / 2 + root.size * 0.02;
        y: (parent.height - self.height) / 2;
    }
    if root.playing: Rectangle {
        width: root.size * 0.34;
        height: root.size * 0.38;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        Rectangle { x: 0; width: parent.width * 0.36; height: parent.height; border-radius: self.width / 2.6; background: root.icon-color; }
        Rectangle { x: parent.width * 0.64; width: parent.width * 0.36; height: parent.height; border-radius: self.width / 2.6; background: root.icon-color; }
    }
    accessible-role: button;
    accessible-label: root.playing ? "Pausar" : "Reproducir";
    ta := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}
